@page
@model IndexModel
@{
    ViewData["Title"] = "chatserver";
}

    <div class="container">
        <div class="row">
            <div class="eight columns">
                <h5>— Ephemeral Chat —</h5>
            </div>
        </div>
        <div class="row">
            <div id="discussion" class="ten columns"></div>
            <div id="people-bar" title="Show people">
                <div id="people-avatars"></div>
                <span id="people-count">0</span>
            </div>
            <div id="userlist" class="collapsed">
                <div id="userlist-header">
                    <h5>people</h5>
                    <span id="people-pin" title="Pin sidebar">📌</span>
                    <span id="people-close" title="Close">✕</span>
                </div>
                <div id="users"></div>
            </div>
            <div id="userlist-backdrop" class="hidden"></div>
                <div class="row" >
                    <div class="eight columns">
                        <input type="button" id="reconnect" value="Reconnect" style="display:none"/>
                        <textarea class="textinput" rows="4" id="message" autofocus></textarea>
                        <div id="file-staging" style="display:none">
                            <span id="staged-file-preview"></span>
                            <span id="staged-file-name"></span>
                            <span id="staged-file-remove" title="Remove file">✕</span>
                        </div>
                    </div>
                    <div class="one column">
                        <input type="button" id="sendmessage" value="Send" />
                        <input type="button" id="sendrawmessage" title="Send as raw text" value="Send Code" />
                        <label id="uploadlabel" for="fileupload" class="disabled" title="File sharing requires another person in chat">+</label>
                        <input type="file" id="fileupload" style="display:none" disabled />
                    </div>
                </div>
                <div class="row" >
                    <div class="six columns" style="line-height: 0">
                        <span class="info"><b>Ctrl+Enter</b> to send.   </span>
                    </div>
                </div>
            <!--<ul id="discussion"></ul>-->
        </div>
    </div>
        <!--Script references. -->
        <!--Reference the SignalR library. -->
        <script type="text/javascript" src="lib/signalr.min.js"></script>
        <!--Add script to update the page and send messages.-->
        <script type="text/javascript">
            function KeyPress(e) {
                var evtobj = window.event ? event : e
                // handle Ctrl+Enter
                if (evtobj.keyCode == 13 && evtobj.ctrlKey && evtobj.shiftKey) {
                    document.getElementById('sendrawmessage').click();
                }
                else if (evtobj.keyCode == 13 && evtobj.ctrlKey) {
                    document.getElementById('sendmessage').click();
                };
            }
            // prevent sleeping tab
            var lockResolver;
            if (navigator && navigator.locks && navigator.locks.request) {
                const promise = new Promise((res) => {
                    lockResolver = res;
                });

                navigator.locks.request('chatserver_lock', { mode: "shared" }, () => {
                    return promise;
                });
            }
            var name;
            document.onkeydown = KeyPress;
            document.addEventListener('DOMContentLoaded', function () {

                var messageInput = document.getElementById('message');

                // Get the user name and store it to prepend to messages.
                // Set initial focus to message input box.
                messageInput.focus();

                // Start the connection.
                var connection = new signalR.HubConnectionBuilder()
                    .withUrl('/chat')
                    .withAutomaticReconnect()
                    .build();

                console.log(`name = ${name}`);
                if (!name || name === "null") {
                    name = getUserName();
                }
                // Create a function that the hub can call to broadcast messages.
                connection.on('broadcastMessage', function (name, message) {
                    var chatDiv = document.createElement("div");
                    chatDiv.className = "chat";
                    chatDiv.innerHTML = '<div class="user" style="background-color:' + colorFromString(name) + '"><strong>' + name
                + '</strong></div><div class="message">' + message + '</div><span class="copybutton" title="Copy to clipboard" onclick="copyMessage(this);">&#x1f4cb;</span></div>';
                    document.getElementById('discussion').appendChild(chatDiv);
                });
                connection.on('broadcastFile', function (senderName, fileName, fileData) {
                    var chatDiv = document.createElement('div');
                    chatDiv.className = 'chat';

                    var userDiv = document.createElement('div');
                    userDiv.className = 'user';
                    userDiv.style.backgroundColor = colorFromString(senderName);
                    userDiv.innerHTML = '<strong>' + senderName + '</strong>';

                    var msgDiv = document.createElement('div');
                    msgDiv.className = 'message';
                    if (fileData.match(/^data:image\//)) {
                        var img = document.createElement('img');
                        img.src = fileData;
                        img.alt = fileName;
                        img.className = 'chat-image';
                        msgDiv.appendChild(img);
                    } else {
                        var link = document.createElement('a');
                        link.href = fileData;
                        link.download = fileName;
                        link.className = 'file-link';
                        link.textContent = '\ud83d\udcce ' + fileName;
                        msgDiv.appendChild(link);
                    }

                    var copyBtn = document.createElement('span');
                    copyBtn.className = 'copybutton';
                    copyBtn.title = 'Copy to clipboard';
                    copyBtn.onclick = function() { copyMessage(this); };
                    copyBtn.textContent = '\ud83d\udccb';

                    chatDiv.appendChild(userDiv);
                    chatDiv.appendChild(msgDiv);
                    chatDiv.appendChild(copyBtn);
                    document.getElementById('discussion').appendChild(chatDiv);
                });
                connection.on("nameList", function (names) {
                    names = JSON.parse(names);
                    console.log(names);
                    // Render full user list in panel
                    var nameDiv = document.getElementById("users");
                    nameDiv.innerHTML = "";
                    names.forEach(function (x) {
                        var newDiv = document.createElement("div");
                        newDiv.className = "user";
                        newDiv.style = "background-color:" + colorFromString(x.Name);
                        newDiv.innerText = x.Name;
                        newDiv.title = x.Status;
                        newDiv.classList += " " + x.Status;
                        nameDiv.appendChild(newDiv);
                    });
                    // Render collapsed bar avatars
                    var avatarDiv = document.getElementById("people-avatars");
                    avatarDiv.innerHTML = "";
                    names.forEach(function (x) {
                        var a = document.createElement("span");
                        a.className = "avatar" + (x.Status === "Disconnected" ? " Disconnected" : "");
                        a.style.backgroundColor = colorFromString(x.Name);
                        a.textContent = x.Name.charAt(0).toUpperCase();
                        a.title = x.Name;
                        avatarDiv.appendChild(a);
                    });
                    document.getElementById("people-count").textContent = names.length;
                    // Enable file upload only when at least one other person is present
                    var uploadLabel = document.getElementById('uploadlabel');
                    var fileUpload = document.getElementById('fileupload');
                    if (names.length > 1) {
                        uploadLabel.classList.remove('disabled');
                        fileUpload.disabled = false;
                    } else {
                        uploadLabel.classList.add('disabled');
                        fileUpload.disabled = true;
                    }
                connection.onreconnecting(error => {
                    console.assert(connection.state === signalR.HubConnectionState.Reconnecting);

                    document.getElementById("message").disabled = true;
                    document.getElementById("sendmessage").disabled = true;
                    document.getElementById("reconnect").style.display = "none";
                   

                    const div = document.createElement("div");
                    div.className = "systemmessage";
                    div.textContent = `Connection lost due to error "${error}". Reconnecting.`;
                    document.getElementById("discussion").appendChild(div);
                    });
                });
                connection.onreconnected(connectionId => {
                    console.assert(connection.state === signalR.HubConnectionState.Connected);
                    connection.invoke("registerName", name);
                    document.getElementById("message").disabled = false;
                    document.getElementById("sendmessage").disabled = false;
                    document.getElementById("reconnect").style.display = "none";

                    const div = document.createElement("div");
                    div.className = "systemmessage";
                    div.textContent = `Connection reestablished. 😊`;
                    document.getElementById("discussion").appendChild(div);
                });
                connection.onclose(error => {
                    console.assert(connection.state === signalR.HubConnectionState.Disconnected);

                    document.getElementById("message").disabled = true;
                    document.getElementById("sendmessage").disabled = true;

                    const div = document.createElement("div");
                    div.className = "systemmessage";
                    div.textContent = `Connection lost. Attempting to reconnect...`;
                    document.getElementById("discussion").appendChild(div);

                    // Auto-reconnect with exponential backoff
                    var retryDelay = 1000;
                    var maxDelay = 30000;
                    function autoReconnect() {
                        console.log(`Auto-reconnecting in ${retryDelay}ms...`);
                        setTimeout(function() {
                            if (connection.state === signalR.HubConnectionState.Disconnected) {
                                connection.start()
                                    .then(function() {
                                        console.log('connection reestablished');
                                        connection.invoke("registerName", name);
                                        document.getElementById("message").disabled = false;
                                        document.getElementById("sendmessage").disabled = false;
                                        document.getElementById("reconnect").style.display = "none";
                                        const div = document.createElement("div");
                                        div.className = "systemmessage";
                                        div.textContent = `Connection reestablished. 😊`;
                                        document.getElementById("discussion").appendChild(div);
                                    })
                                    .catch(function(err) {
                                        console.error('Reconnect failed:', err.message);
                                        retryDelay = Math.min(retryDelay * 2, maxDelay);
                                        autoReconnect();
                                    });
                            }
                        }, retryDelay);
                    }
                    autoReconnect();
                });
                // Transport fallback functionality is now built into start.
                /* connection.hub.disconnected(function() {
                    setTimeout(function() {
                        connection.hub.start();
                    }, 5000); // Restart connection after 5 seconds.
                }); */
                connection.start()
                    .then(function () {
                        console.log('connection started');
                        connection.invoke("registerName", name);
                        document.getElementById('sendmessage').addEventListener('click', function (event) {
                            // Call the Send method on the hub.
                            sendMessage(document.getElementById('message').value)
                            event.preventDefault();
                        });
                            document.getElementById('sendrawmessage').addEventListener('click', function (event) {
                            // Call the Send method on the hub.
                            sendMessage(document.getElementById('message').value, true)
                            event.preventDefault();
                        });
                            document.getElementById('reconnect').addEventListener('click', function (event) {
                            // Call the Send method on the hub.
                                document.getElementById("reconnect").className = "disabled";
                                connection.start()
                                .then(function () {
                                    console.log('connection started');
                                    connection.invoke("registerName", name);
                                    document.getElementById("message").disabled = false;
                                    document.getElementById("sendmessage").disabled = false;
                                    document.getElementById("reconnect").style.display = "none";
                                    const div = document.createElement("div");
                                    div.className = "systemmessage";
                                    div.textContent = `Connection reestablished. 😊`;
                                    document.getElementById("discussion").appendChild(div);
                                })
                                .catch(error => {
                                    console.error(error.message);
                                })
                            event.preventDefault();
                        });


                        // Paste binary files (images, etc.) into chat
                        messageInput.addEventListener('paste', function(e) {
                            var items = e.clipboardData && e.clipboardData.items;
                            if (!items) return;
                            for (var i = 0; i < items.length; i++) {
                                if (items[i].kind === 'file') {
                                    e.preventDefault();
                                    handleFile(items[i].getAsFile());
                                    return;
                                }
                            }
                        });

                        // "+" button file upload
                        document.getElementById('fileupload').addEventListener('change', function() {
                            if (this.files && this.files[0]) {
                                handleFile(this.files[0]);
                                this.value = '';
                            }
                        });

                    })
                    .catch(error => {
                        console.error(error.message);
                    });
                function sendMessage(message, raw) {
                                var messageInput = document.getElementById('message');
                                // Send staged file if present
                                if (stagedFile) {
                                    connection.invoke('sendFile', name, stagedFile.name, stagedFile.data);
                                    clearStagedFile();
                                }
                                var msg = messageInput.value;
                                if (msg.length > 0) {
                                    if (raw && !msg.startsWith("```\n")) {
                                        msg = "```\n" + msg + "\n```";
                                    }
                                    connection.invoke('send', name, msg);
                                }

                                // Clear text box and reset focus for next comment.
                                messageInput.value = '';
                                messageInput.focus();
                }
                var MAX_FILE_SIZE = 5 * 1024 * 1024; // 5MB
                var stagedFile = null; // { name, data }

                function stageFile(fileName, fileData) {
                    stagedFile = { name: fileName, data: fileData };
                    var staging = document.getElementById('file-staging');
                    var preview = document.getElementById('staged-file-preview');
                    document.getElementById('staged-file-name').textContent = fileName;
                    preview.innerHTML = '';
                    if (fileData.match(/^data:image\//)) {
                        var img = document.createElement('img');
                        img.src = fileData;
                        img.className = 'staged-thumb';
                        preview.appendChild(img);
                    } else {
                        preview.textContent = '📎';
                    }
                    staging.style.display = 'flex';
                    document.getElementById('sendrawmessage').disabled = true;
                }

                function clearStagedFile() {
                    stagedFile = null;
                    document.getElementById('file-staging').style.display = 'none';
                    document.getElementById('staged-file-preview').innerHTML = '';
                    document.getElementById('staged-file-name').textContent = '';
                    document.getElementById('sendrawmessage').disabled = false;
                }

                document.getElementById('staged-file-remove').addEventListener('click', clearStagedFile);

                // People sidebar toggle/pin logic
                var sidebarPinned = false;
                var userlistEl = document.getElementById('userlist');
                var backdrop = document.getElementById('userlist-backdrop');
                var pinBtn = document.getElementById('people-pin');

                function openSidebar() {
                    userlistEl.classList.remove('collapsed');
                    if (!sidebarPinned) backdrop.classList.remove('hidden');
                    document.getElementById('discussion').classList.toggle('sidebar-open', sidebarPinned);
                }
                function closeSidebar() {
                    if (sidebarPinned) return;
                    userlistEl.classList.add('collapsed');
                    backdrop.classList.add('hidden');
                    document.getElementById('discussion').classList.remove('sidebar-open');
                }
                function togglePin() {
                    sidebarPinned = !sidebarPinned;
                    pinBtn.classList.toggle('pinned', sidebarPinned);
                    backdrop.classList.toggle('hidden', true);
                    document.getElementById('discussion').classList.toggle('sidebar-open', sidebarPinned);
                }

                document.getElementById('people-bar').addEventListener('click', openSidebar);
                document.getElementById('people-close').addEventListener('click', function() {
                    if (sidebarPinned) { togglePin(); }
                    closeSidebar();
                    userlistEl.classList.add('collapsed');
                    document.getElementById('discussion').classList.remove('sidebar-open');
                });
                pinBtn.addEventListener('click', togglePin);
                backdrop.addEventListener('click', closeSidebar);

                function handleFile(file) {
                    if (!file) return;
                    if (document.getElementById('uploadlabel').classList.contains('disabled')) {
                        alert('File sharing requires at least one other person in the chat.');
                        return;
                    }
                    if (file.size > MAX_FILE_SIZE) {
                        alert('File is too large. Maximum size is 5MB.');
                        return;
                    }
                    var reader = new FileReader();
                    reader.onload = function() {
                        stageFile(file.name, reader.result);
                    };
                    reader.readAsDataURL(file);
                }
            });
            function getUserName() {
                var answer = prompt('Enter your name:', '');
                displayName = answer || "anon_" + Math.floor(Math.random() * 1000);
                displayName = displayName.substr(0, 50);
                return displayName;
            }
            function colorFromString(input_str) {
                // set the minimum value to be used for each R, G, B (0-255)
                var base = 160;
                // get a checksum
                var seed = 0; for (var i in input_str) { seed += input_str.charCodeAt(i) * (i + 1); }
                // get deterministic values based on name
                var rand_1 = Math.abs((Math.sin(seed++) * 10000)) % 256;
                var rand_2 = Math.abs((Math.sin(seed++) * 10000)) % 256;
                var rand_3 = Math.abs((Math.sin(seed++) * 10000)) % 256;
                // build color
                var red = base + Math.round(rand_1 * (1 - base / 255));
                var green = base + Math.round(rand_2 * (1 - base / 255));
                var blue = base + Math.round(rand_3 * (1 - base / 255));
                return "rgb(" + red + "," + green + "," + blue + ")";
            }
            function copyMessage(element) {
                var msg = element.previousElementSibling;
                var img = msg.querySelector('img');
                if (img) {
                    fetch(img.src)
                        .then(function(r) { return r.blob(); })
                        .then(function(blob) {
                            // Ensure we use a supported MIME type for clipboard
                            var type = blob.type === 'image/png' ? 'image/png' : 'image/png';
                            if (blob.type !== 'image/png') {
                                // Convert to PNG via canvas for clipboard compatibility
                                var canvas = document.createElement('canvas');
                                var tmpImg = new Image();
                                tmpImg.onload = function() {
                                    canvas.width = tmpImg.width;
                                    canvas.height = tmpImg.height;
                                    canvas.getContext('2d').drawImage(tmpImg, 0, 0);
                                    canvas.toBlob(function(pngBlob) {
                                        navigator.clipboard.write([
                                            new ClipboardItem({ 'image/png': pngBlob })
                                        ]).then(function() { markCopied(element); },
                                               function() { console.log("copy failed"); });
                                    }, 'image/png');
                                };
                                tmpImg.src = img.src;
                            } else {
                                navigator.clipboard.write([
                                    new ClipboardItem({ 'image/png': blob })
                                ]).then(function() { markCopied(element); },
                                       function() { console.log("copy failed"); });
                            }
                        });
                } else {
                    navigator.clipboard.writeText(msg.innerText).then(
                        function () { markCopied(element); },
                        function () { console.log("copy failed"); }
                    );
                }
            }
            function markCopied(element) {
                console.log("copied");
                var buttons = document.querySelectorAll(".copybutton");
                buttons.forEach(x => { x.innerText = "📋"; });
                element.innerText = "✔";
            }
        </script>
